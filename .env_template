POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=scrabble
DATABASE_URL=postgresql://postgres:postgres@postgres-scrabble:5432/scrabble
SECRET_KEY=change-me-in-production
DEBUG=true
NODE_ENV=development
PORT=8000
CORS_ORIGIN=http://localhost:3000
VITE_API_URL=http://localhost:8000
VITE_SOCKET_URL=http://localhost:8000

# Production deploy is configured in GitHub, not in this file.
# Secrets: DEPLOY_HOST, DEPLOY_USER, DEPLOY_SSH_KEY, DEPLOY_KNOWN_HOSTS
# Optional secret: DEPLOY_SSH_PORT (default 22)
# Repository variable: DEPLOY_PATH=/opt/apps/fast-scrabble
# App secrets (POSTGRES_PASSWORD, SECRET_KEY, ...) stay in the server .env only.
