POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=scrabble
DATABASE_URL=postgresql://postgres:postgres@postgres-scrabble:5432/scrabble
SECRET_KEY=change-me-in-production
DEBUG=true
NODE_ENV=development
PORT=8000
CORS_ORIGIN=http://localhost:3000
VITE_API_URL=http://localhost:8000
VITE_SOCKET_URL=http://localhost:8000

# Production deploy uses the GitHub environment "production", not this file.
# Secrets: DEPLOY_HOST, DEPLOY_USER, DEPLOY_SSH_KEY, POSTGRES_PASSWORD
# Optional secret: DEPLOY_SSH_PORT (default 22)
# Variables: POSTGRES_USER, POSTGRES_DB
# DEPLOY_PATH=/opt/apps/fast-scrabble is hardcoded in the deploy workflow.
