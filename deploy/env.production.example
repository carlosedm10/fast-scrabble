# Shape of /opt/apps/fast-scrabble/.env
# The deploy workflow writes this file from the GitHub "production" environment.
# Never commit a real .env.

POSTGRES_USER=scrabble
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=scrabble
DATABASE_URL=postgresql://scrabble:change-me-strong-password@postgres-scrabble:5432/scrabble

NODE_ENV=production
PORT=8200
BASE_PATH=/scrabble
CORS_ORIGIN=https://games.carloseduardo.es
