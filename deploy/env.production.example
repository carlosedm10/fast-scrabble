# Production .env for /opt/apps/fast-scrabble
# Copy to the server as .env (never commit .env):
#   cp deploy/env.production.example .env && nano .env

POSTGRES_USER=scrabble
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=scrabble
DATABASE_URL=postgresql://scrabble:change-me-strong-password@postgres-scrabble:5432/scrabble

SECRET_KEY=change-me-long-random-string
NODE_ENV=production
DEBUG=false

# Backend (compose.prod.yaml also sets these; keep in sync)
PORT=8200
BASE_PATH=/scrabble
CORS_ORIGIN=https://games.carloseduardo.es
